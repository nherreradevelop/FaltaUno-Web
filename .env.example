# FaltaUno - variables de entorno de la web (copiar como .env; no se sube al repositorio)
# Las variables de Vite tienen que empezar con VITE_ y quedan visibles en el navegador: nunca poner secretos acá.

VITE_URL_API=http://localhost:3000
# Client ID de OAuth de tipo "Aplicación web" (Google Cloud Console). Vacío: no se muestra el botón de Google.
VITE_GOOGLE_CLIENT_ID=
