# FaltaUno - variables de entorno de la web (copiar como .env; no se sube al repositorio)
# Las variables de Vite tienen que empezar con VITE_ y quedan visibles en el navegador: nunca poner secretos acá.

VITE_URL_API=http://localhost:3000
# Client ID de OAuth de tipo "Aplicación web" (Google Cloud Console). Vacío: no se muestra el botón de Google.
VITE_GOOGLE_CLIENT_ID=
# API key de Google Maps con la "Maps JavaScript API" habilitada (CU09: mapa interactivo de "Cómo llegar").
# Restringirla por sitio web (localhost:5173 y el dominio de producción). Vacía: se usa el mapa embebido, que no lleva key.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud → Google Maps Platform → Gestión de mapas). Vacío: DEMO_MAP_ID, que solo sirve para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=
